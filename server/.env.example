# Backend Server Port
PORT=5000

# MongoDB Connection String (Local or Atlas URL)
MONGODB_URI=mongodb://127.0.0.1:27017/is-recommend

# JWT Secret for Auth
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Key for AI Chatbot and Smart Search
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE

# Semantic search confidence threshold (provisional default: 0.40)
# Queries below this score return no primary recommendation.
# THIS VALUE IS PROVISIONAL and must be calibrated against a representative
# evaluation dataset of real procurement queries before production use.
# Acceptable range: 0.0 to 1.0
RECOMMENDATION_CONFIDENCE_THRESHOLD=0.40
