# Backend Server Port
PORT=5000

# MongoDB Connection String (Local or Atlas URL)
MONGODB_URI=mongodb://127.0.0.1:27017/is-recommend

# JWT Secret for Auth
JWT_SECRET=replace_with_a_secure_random_jwt_secret

# CORS
CORS_ORIGIN=http://localhost:5173

# Google Gemini API Key for AI Chatbot and Smart Search
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_API_KEY_HERE
